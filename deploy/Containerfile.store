# The store's container (03b §2: one store server in its own container, one container per tenant; it is the only
# writer of every governed path).
#
# **One process.** The store terminates its own mTLS (ruled 7bg.8): it answers the connection, requires a client
# certificate the tenant registration's CA issued, and reads that certificate off the connection it authorizes.
# There is no proxy, no Unix socket, no forwarded header and no trusted hop — so there is no second process, no
# socket permission to be the boundary between them, and the entrypoint `exec`s the store as PID 1.
#
# The image holds python, git and the store. Nothing else.
#
# **Both bases are pinned by digest** (K5, ruling 7bg.5). The tag stays beside the digest because a tag is readable
# and a digest is not, but it is the digest that is fetched: a tag is a moving name and `python:3.12-slim` is
# rebuilt weekly, so an unpinned base means two builds of the same commit are two different images. The digest is
# the **multi-arch index**, not one platform's manifest, so the same line builds on amd64 and arm64. Resolved
# 2026-09-04 from registry-1.docker.io; Renovate proposes the bump, and a bump here is a rebuild and a restart of
# every tenant's store, which is why renovate.json refuses to group it with anything.

FROM docker.io/library/python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea AS build
# uv builds the wheel and writes the hash-pinned requirements the runtime stage installs from. It is copied
# in as a single static binary from its own image, digest-pinned like every other reference in this file, and
# it never reaches the runtime stage — the shipped image gains nothing from this line.
COPY --from=ghcr.io/astral-sh/uv:0.12.10@sha256:2bb3ebca0a796a155094a27773d290c4b074572e6107f171d88d086682fd2500 /uv /usr/local/bin/uv
WORKDIR /src
# The whole workspace, because one lock covers it: `uv.lock` resolves `isidium-store` in the company of the
# sibling it shares a namespace with, so exporting one member's dependencies means reading the manifest both
# are in. None of this stage survives into the image.
COPY pyproject.toml uv.lock /src/
COPY packages /src/packages
# **The export is the lock, narrowed** [K5, 2026-09-04]: the runtime dependencies of `isidium-store` with both
# extras, no dev group and no workspace member (the wheel below is the member), every version `==` and every
# artifact carrying its sha256. `--locked` refuses a lock that no longer matches `pyproject.toml`, so a
# drifted manifest fails the image build instead of shipping a resolution nobody recorded. The export runs
# **here, inside the target platform**, so the universal lock's markers are evaluated by the same OS and the
# same Python that will install them.
RUN uv export --locked --no-dev --no-emit-workspace --package isidium-store \
      --extra server --extra telemetry --format requirements-txt -o /wheels/requirements.txt \
 && uv build --wheel --package isidium-store --out-dir /wheels

FROM docker.io/library/python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea
# git is the store's own tool: it holds the tenant's partial bare clone and commits governed writes to `main`.
# **`openssh-client` is what a deploy key needs** (K8): a forge's deploy key is an SSH key, and an origin of the form
# `git@forge:owner/repo.git` can be neither cloned nor pushed without a client. The image before this line could
# clone over https and could push nowhere with a key. Measured 2026-09-03: 5.55 MB on a 301.6 MB image (1.9%);
# deploy/README.md, "Tenant #0".
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates openssh-client \
 && rm -rf /var/lib/apt/lists/*

COPY --from=build /wheels /wheels
# **`[server]`, not uvicorn.** The previous line installed `uvicorn>=0.30,<1` directly into the image — a version
# constraint in a Containerfile, where K5's lock cannot see it, for a dependency 7bg.8 removed from the design and K1
# removed from the distribution. Worse, it never installed the extra the store actually needs: `server/http.py`
# imports h11, which is `[server]`, so this image could not have run `serve` at all.
#
# **`[telemetry]` is installed, and that is not the same as enabled** (C-11). `core/telemetry.configure()` installs
# no provider unless `OTEL_TRACES_EXPORTER` / `OTEL_METRICS_EXPORTER` say so — unset means `none`, deliberately — so
# egress stays the deployment's decision, taken in `compose.yaml`, not the image's. What being present buys is that
# the first start can be made diagnosable with an environment variable instead of a rebuild, which is the whole point
# of instrumenting before the container stands up. Measured cost of the extra in this image: see deploy/README.md.
#
# **Two installs, and the order is the point** [K5, 2026-09-04]. This was one `pip install` of the wheel with
# its extras, which resolved pydantic, cryptography, httpx, typer and the OpenTelemetry packages against PyPI
# *at build time* — so the lock this repository checks in CI stopped at the container door, and the artifact
# that actually runs was the one place nothing was pinned. The dependencies now come from the exported lock
# under `--require-hashes`, which makes pip refuse anything whose bytes do not match, and the store's own
# wheel goes in `--no-deps` because everything it needs is already present. `--no-deps` is safe *only* in
# that order, and only because the line above it cannot silently resolve anything.
RUN python -m pip install --no-cache-dir --require-hashes -r /wheels/requirements.txt \
 && python -m pip install --no-cache-dir --no-deps "$(printf '%s' /wheels/isidium_store-*.whl)" \
 && rm -rf /wheels

# The store runs as its own unprivileged user — the container is the identity boundary (03 §1.3).
#
# **`repo/` is deliberately inside the image's writable layer and must never be a bind mount.** The store's clone is
# derived, not authored: the entrypoint recreates it at every start (see entrypoint.sh), which is what makes
# "a bypass commit is visible after a restart" true rather than aspirational.
RUN useradd --system --create-home --home-dir /var/lib/isidium isidium \
 && mkdir -p /var/lib/isidium/repo /var/lib/isidium/state /var/lib/isidium/.ssh /etc/isidium/tls /etc/isidium/ssh \
 && chmod 0700 /var/lib/isidium/.ssh \
 && chown -R isidium:isidium /var/lib/isidium

COPY deploy/entrypoint.sh /usr/local/bin/isidium-entrypoint
COPY deploy/healthcheck.py /usr/local/bin/isidium-healthcheck
# The forge's host keys, pinned in the image rather than learned on first contact (K8). `deploy/known_hosts` says
# where each line came from and carries the fingerprints to check it against. It lives outside /etc/isidium/ssh on
# purpose: that directory is the deployment's read-only mount for the deploy key, and a mount there must not shadow
# the pin.
COPY deploy/known_hosts /etc/isidium/known_hosts
RUN chmod 0755 /usr/local/bin/isidium-entrypoint /usr/local/bin/isidium-healthcheck \
 && chmod 0644 /etc/isidium/known_hosts

# The image's own layout, not policy: these are where things live in this filesystem. Every value that is a
# *decision* — the tenant, the origin, the tracking root, the address — has no default here and the entrypoint
# refuses without it (C-1: no default lives in code, and a container is code).
ENV ISIDIUM_REGISTRATION=/etc/isidium/registration.json \
    ISIDIUM_REPO_DIR=/var/lib/isidium/repo \
    ISIDIUM_STATE_DIR=/var/lib/isidium/state \
    ISIDIUM_TLS_DIR=/etc/isidium/tls \
    ISIDIUM_SSH_DIR=/etc/isidium/ssh \
    ISIDIUM_KNOWN_HOSTS=/etc/isidium/known_hosts \
    HOME=/var/lib/isidium

# A data directory, not a checkout. There is no working tree in this container: the store's clone is bare (K4), and
# `cd`-ing into one was the previous version's assumption (Q6, which is why this file was written after K4).
WORKDIR /var/lib/isidium
USER isidium
EXPOSE 8443

# No HEALTHCHECK here on purpose: a check must present a client certificate this CA issued (S-4), and which
# certificate, mounted where, is the deployment's to say. It is declared once, in compose.yaml.
ENTRYPOINT ["/usr/local/bin/isidium-entrypoint"]
