# The store's container (03b §2: one store server in its own container, one container per tenant; it is the only
# writer of every governed path).
#
# **One process.** The store terminates its own mTLS (ruled 7bg.8): it answers the connection, requires a client
# certificate the tenant registration's CA issued, and reads that certificate off the connection it authorizes.
# There is no proxy, no Unix socket, no forwarded header and no trusted hop — so there is no second process, no
# socket permission to be the boundary between them, and the entrypoint `exec`s the store as PID 1.
#
# The image holds python, git and the store. Nothing else.

FROM docker.io/library/python:3.12-slim AS build
WORKDIR /src
COPY packages/isidium-store /src/packages/isidium-store
RUN python -m pip install --no-cache-dir --upgrade pip build \
 && python -m build --wheel --outdir /wheels /src/packages/isidium-store

FROM docker.io/library/python:3.12-slim
# git is the store's own tool: it holds the tenant's partial bare clone and commits governed writes to `main`.
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates \
 && rm -rf /var/lib/apt/lists/*

COPY --from=build /wheels /wheels
# **`[server]`, not uvicorn.** The previous line installed `uvicorn>=0.30,<1` directly into the image — a version
# constraint in a Containerfile, where K5's lock cannot see it, for a dependency 7bg.8 removed from the design and K1
# removed from the distribution. Worse, it never installed the extra the store actually needs: `server/http.py`
# imports h11, which is `[server]`, so this image could not have run `serve` at all.
#
# **`[telemetry]` is installed, and that is not the same as enabled** (C-11). `core/telemetry.configure()` installs
# no provider unless `OTEL_TRACES_EXPORTER` / `OTEL_METRICS_EXPORTER` say so — unset means `none`, deliberately — so
# egress stays the deployment's decision, taken in `compose.yaml`, not the image's. What being present buys is that
# the first start can be made diagnosable with an environment variable instead of a rebuild, which is the whole point
# of instrumenting before the container stands up. Measured cost of the extra in this image: see deploy/README.md.
RUN python -m pip install --no-cache-dir "$(printf '%s' /wheels/isidium_store-*.whl)[server,telemetry]" \
 && rm -rf /wheels

# The store runs as its own unprivileged user — the container is the identity boundary (03 §1.3).
#
# **`repo/` is deliberately inside the image's writable layer and must never be a bind mount.** The store's clone is
# derived, not authored: the entrypoint recreates it at every start (see entrypoint.sh), which is what makes
# "a bypass commit is visible after a restart" true rather than aspirational.
RUN useradd --system --create-home --home-dir /var/lib/isidium isidium \
 && mkdir -p /var/lib/isidium/repo /var/lib/isidium/state /etc/isidium/tls \
 && chown -R isidium:isidium /var/lib/isidium

COPY deploy/entrypoint.sh /usr/local/bin/isidium-entrypoint
COPY deploy/healthcheck.py /usr/local/bin/isidium-healthcheck
RUN chmod 0755 /usr/local/bin/isidium-entrypoint /usr/local/bin/isidium-healthcheck

# The image's own layout, not policy: these are where things live in this filesystem. Every value that is a
# *decision* — the tenant, the origin, the tracking root, the address — has no default here and the entrypoint
# refuses without it (C-1: no default lives in code, and a container is code).
ENV ISIDIUM_REGISTRATION=/etc/isidium/registration.json \
    ISIDIUM_REPO_DIR=/var/lib/isidium/repo \
    ISIDIUM_STATE_DIR=/var/lib/isidium/state \
    ISIDIUM_TLS_DIR=/etc/isidium/tls

# A data directory, not a checkout. There is no working tree in this container: the store's clone is bare (K4), and
# `cd`-ing into one was the previous version's assumption (Q6, which is why this file was written after K4).
WORKDIR /var/lib/isidium
USER isidium
EXPOSE 8443

# No HEALTHCHECK here on purpose: a check must present a client certificate this CA issued (S-4), and which
# certificate, mounted where, is the deployment's to say. It is declared once, in compose.yaml.
ENTRYPOINT ["/usr/local/bin/isidium-entrypoint"]
