# The run container — one phase of one run, and nothing else [V4a-i, T-C6's headless CLI-in-container adapter].
#
# **The contract with the factory is two files.** `/run/job.json` comes in (the typed `RunJob`), `/run/result.json`
# goes out (the typed `PhaseResult`), and `/work` is the run's worktree. Nothing about podman, the forge or the
# store crosses that boundary in either direction — which is the only reason `adapter.py` can be free of harness
# words. What happens between the two files is this image's business.
#
# **The image holds no credential and no identity.** The model token arrives in the environment at `podman run`
# (by name, never in `argv`); the git identity is the wrapper's, outside, because *"the model never holds git
# credentials"* (7j.5) and the builder holds no store credential at all (W9). There is no `git push` in here and
# nothing to push with.
#
# **The write guard runs inside.** `settings.json`, rendered by the factory from the tenant's signed `[executor]`
# policy, points a PreToolUse hook at `python -m isidium.factory.guard`, which reads `/run/allow.json` — the card's
# own `surfaces`. The factory package is installed here for exactly that: one implementation of the rule, used by
# the hook inside and the recompute outside (see packages/isidium-factory/.../guard.py).
#
# **The base is pinned by digest**, the same multi-arch index the store's image pins, for the same reason: a tag is
# a moving name and two builds of one commit must be one image (K5, ruling 7bg.5). Renovate proposes the bump.

FROM docker.io/library/python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea AS build
COPY --from=ghcr.io/astral-sh/uv:0.13.6@sha256:af22a52f5eafef3d78e551599d405c02df61919d18028f0cea8eda93bc9986d0 /uv /usr/local/bin/uv
WORKDIR /src
COPY pyproject.toml uv.lock /src/
COPY packages /src/packages
# The factory's runtime dependencies from the lock, every version `==` and every artifact carrying its sha256, plus
# the factory's own wheel — the store's build stage, narrowed to the other member. `--locked` fails the build on a
# manifest that drifted from the lock rather than shipping a resolution nobody recorded.
RUN uv export --locked --no-dev --no-emit-workspace --package isidium-factory \
      --format requirements-txt -o /wheels/requirements.txt \
 && uv build --wheel --package isidium-factory --out-dir /wheels \
 && uv build --wheel --package isidium-store --out-dir /wheels
# **The phase's test environment, from the same lock** [card 65]: the resolution CI's `uv sync --locked
# --all-packages --all-extras` installs, with the dev group (pytest, ruff, mypy), minus the workspace packages -- the
# tests put the *worktree's* src trees on the path (pytest's `pythonpath`, mypy's `mypy_path`), so the code under test
# is the worktree's and never an installed wheel. **The environment is the lock at image build**: a card that changes
# `uv.lock` is checked here against the old one until the image is rebuilt, while `green-bar` still checks the new
# one -- the drift is bounded and named, and builder v7 tells the phase to say so.
RUN uv export --locked --all-packages --all-extras --group dev --no-emit-workspace \
      --format requirements-txt -o /tests/requirements.txt

# **Two test environments, one per CI Python, in a stage of their own** [card 65, A1, C1, C2]. They are not the
# runtime install: the guard and the harness run on the system interpreter, and one environment serving both would
# let a card that bumps a test dependency move the interpreter the guard runs on. 3.12 is a venv on the base image's
# own interpreter (the same digest as the final stage, so the symlink resolves there too). 3.13 is an exact patch
# installed by the pinned uv above, which checks its download against the checksum in its own manifest -- no second
# base image, because a tag is a moving name (K5, ruling 7bg.5). **Cost, stated at design time:** one install step
# in the build and roughly 200 to 300 MB in the image; `UV_NO_CACHE` keeps wheels from being shipped beside them.
FROM build AS test-env
ENV UV_PYTHON_INSTALL_DIR=/opt/isidium/uv-python \
    UV_NO_CACHE=1
RUN uv python install 3.13.9 \
 && uv venv --python /usr/local/bin/python3.12 /opt/isidium/py312 \
 && uv venv --python 3.13.9 /opt/isidium/py313 \
 && uv pip install --python /opt/isidium/py312/bin/python3.12 --require-hashes -r /tests/requirements.txt \
 && uv pip install --python /opt/isidium/py313/bin/python --require-hashes -r /tests/requirements.txt
# The 3.12 environment's `bin` goes first on the final PATH, so `python` and `python3` must not exist in it: they
# would shadow /usr/local/bin's, which is the interpreter that has `isidium.factory` -- `render.GUARD_COMMAND` is
# `python -m isidium.factory.guard` and the entrypoint execs `python3 -m isidium.factory.harness`, and a hook that
# exits 1 for want of an import is not a block (PreToolUse reads only exit 2 as one), so the guard would be silently
# off. The console scripts keep working because their shebang is pointed at the one name that stays.
# **That name is re-pointed first, absolutely** [reviewer F1]: `uv venv` makes `bin/python` the one real link (to the
# base interpreter) and `bin/python3` and `bin/python3.12` relative links to `python`, so removing `python` alone would
# leave `python3.12` dangling and every console script with no interpreter. `python3.12` is made a link to the base
# interpreter itself; `pyvenv.cfg` is still found from the unresolved path, so it is still the venv's interpreter.
# Consequence: `python -m pytest` reaches the runtime interpreter, which has no pytest; the phase runs `pytest`.
RUN ln -sfn /usr/local/bin/python3.12 /opt/isidium/py312/bin/python3.12 \
 && rm /opt/isidium/py312/bin/python /opt/isidium/py312/bin/python3 \
 && /opt/isidium/py312/bin/python3.12 -c 'import sys; assert sys.prefix == "/opt/isidium/py312", sys.prefix' \
 && grep -lIZ '^#!/opt/isidium/py312/bin/python3\?$' /opt/isidium/py312/bin/* \
    | xargs -0 -r sed -i '1s|^#!/opt/isidium/py312/bin/python3\?$|#!/opt/isidium/py312/bin/python3.12|'

FROM docker.io/library/python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea

# **No default for the harness version** (C-1: no default lives in code, and a container is code). Which Claude Code
# the runs are executed by is a decision — it is recorded per run as `harness_version` and it decides what the
# conformance suite was green against — so the build refuses rather than silently taking whatever `latest` is on
# the day. `deploy/README.md` says how to read the current one; Renovate proposes the bump like any other pin.
ARG CLAUDE_CODE_VERSION
RUN test -n "$CLAUDE_CODE_VERSION" || { echo "build with --build-arg CLAUDE_CODE_VERSION=<version>" >&2; exit 2; }

# git is the phase's own tool for reading the tree it works in — never for pushing, and there is no credential here
# to push with. nodejs is what the harness runs on.
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates nodejs npm \
 && rm -rf /var/lib/apt/lists/* \
 && npm install -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
 && npm cache clean --force

COPY --from=build /wheels /wheels
RUN python -m pip install --no-cache-dir --require-hashes -r /wheels/requirements.txt \
 && python -m pip install --no-cache-dir --no-deps /wheels/isidium_store-*.whl /wheels/isidium_factory-*.whl \
 && rm -rf /wheels

# The prompts are code (7bd.11, ruled 2026-08-26: *"repo now"* — `prompts/<agent>/<version>.md`, changed by pull
# request, and the run record names the version it ran). They are baked in rather than mounted so that the image and
# the prompt version move together: an image is one harness and one prompt set, and the ledger records both.
# **Build with `deploy/build-runner.sh`** [owner, 2026-09-23]: it writes the set this line copies into the
# `org.isidium.prompts` label, which the factory reads before any spend now that the version is signed policy
# (config@7). An image built with a bare `podman build` has no label, and the factory refuses it.
COPY prompts /opt/isidium/prompts

# The test environments [card 65]: root-owned as COPY leaves them, so the runner user cannot write into either (the
# phase installs nothing; the guard refuses the attempt and says a missing tool is a line in the report). The 3.13
# venv points into uv's managed-Python directory, so that whole directory is copied to the same path. `PATH` puts the
# 3.12 environment's `bin` first, which is what makes `pytest`, `ruff` and `mypy` resolve to it; 3.13 is reached only
# by `$ISIDIUM_PY313/bin/python -m pytest <file or node>`. The runtime install above is unchanged and carries no dev
# group. The check fails the build, rather than a run, if a PATH change ever hid the interpreter the guard needs.
COPY --from=test-env /opt/isidium/uv-python /opt/isidium/uv-python
COPY --from=test-env /opt/isidium/py312 /opt/isidium/py312
COPY --from=test-env /opt/isidium/py313 /opt/isidium/py313
ENV PATH=/opt/isidium/py312/bin:$PATH \
    ISIDIUM_PY313=/opt/isidium/py313
RUN test "$(command -v python3)" = /usr/local/bin/python3 \
 && python3 -c 'import isidium.factory.guard' \
 && pytest --version && ruff --version && mypy --version \
 && "$ISIDIUM_PY313/bin/python" -m pytest --version

# The phase runs as its own unprivileged user. The worktree is bind-mounted writable and is the only thing it may
# write to — and even there, only inside the card's surfaces, which the guard enforces at write time.
RUN useradd --system --create-home --home-dir /home/runner runner \
 && mkdir -p /work /run \
 && chown -R runner:runner /work /run /home/runner
COPY deploy/runner-entrypoint.sh /usr/local/bin/isidium-runner
RUN chmod 0755 /usr/local/bin/isidium-runner

# The harness version a run records (7bdb.4(5)) is the one this image was built with, carried from the build
# argument into the image's own environment. **Found live, 2026-09-12:** this line was missing from the first build
# and every run would have recorded `harness_version: unknown` — the build argument was required to *build* and
# reached nothing that runs. The same class as `ISIDIUM_SIGNER` in `recreate.sh`: a value that is checked at one
# moment and never carried to the moment it is read.
ENV ISIDIUM_PROMPTS=/opt/isidium/prompts \
    ISIDIUM_HARNESS_VERSION=${CLAUDE_CODE_VERSION} \
    HOME=/home/runner
WORKDIR /work
USER runner

# The entrypoint checks its inputs and `exec`s `python3 -m isidium.factory.harness` as PID 1, which forwards the
# watchdog's `podman kill --signal TERM` to the harness it spawned. K6b's lesson, learned a second time (Q-V25): the
# first version left the shell as PID 1 with the harness a foreground child, and the signal reached nothing.
ENTRYPOINT ["/usr/local/bin/isidium-runner"]
